<Project>
  <PropertyGroup Label="Product Infomation">
    <Company>Creatorflow.io</Company>
    <Product>Juice core</Product>
    <Copyright>© $(Company). All rights reserved.</Copyright>
    <Authors>$(Company)</Authors>
    <JuiceDescription>$(Product) is a media management framework</JuiceDescription>
    <Description>$(Product) - Media Managment System.</Description>
    <PackageTags>$(PackageTags); $(Company); $(Product); Media Management</PackageTags>
    <PackageIconUrl>https://avatars.githubusercontent.com/u/107674950</PackageIconUrl>
    <RepositoryUrl>https://github.com/creatorflow-io/Juice</RepositoryUrl>

    <VersionPrefix>10.3.0</VersionPrefix>
    <VersionSuffix>local.$([System.DateTime]::Now.ToString(`yyyyMMdd`)).1</VersionSuffix>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <LibraryTargetFramework>netstandard2.1</LibraryTargetFramework>
    <AppTargetFramework>net6.0;net8.0;net9.0;net10.0</AppTargetFramework>
    <AppTestTargetFramework>net8.0;net9.0;net10.0</AppTestTargetFramework>
    <GrpcVersion>2.57.0</GrpcVersion>
    <ProtobufVersion>3.24.3</ProtobufVersion>
    <MediatRVersion>12.4.*</MediatRVersion>
    <RedisVersion>2.8.*</RedisVersion>
    <FinbuckleVersion>9.1.*</FinbuckleVersion>
    <OpenApiVersion>2.4.*</OpenApiVersion>
    <XUnitV3Version>3.2.*</XUnitV3Version>
    <XUnitRunnerVersion>3.1.*</XUnitRunnerVersion>
    <TestSdk>17.11.*</TestSdk>
  </PropertyGroup>

  <PropertyGroup Label="Versioning" Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftExtensionsVersion>10.0.*</MicrosoftExtensionsVersion>
    <EFVersion>10.0.*</EFVersion>
    <NpgsqlVersion>10.0.*</NpgsqlVersion>
    <MvcTesting>$(MicrosoftExtensionsVersion)</MvcTesting>
    <AspNetCoreVersion>$(MicrosoftExtensionsVersion)</AspNetCoreVersion>
    <SwashbuckleVersion>10.*</SwashbuckleVersion>
  </PropertyGroup>
  
  <PropertyGroup Label="Versioning" Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftExtensionsVersion>9.0.*</MicrosoftExtensionsVersion>
    <EFVersion>9.0.*</EFVersion>
    <NpgsqlVersion>9.0.*</NpgsqlVersion>
    <MvcTesting>$(MicrosoftExtensionsVersion)</MvcTesting>
    <AspNetCoreVersion>$(MicrosoftExtensionsVersion)</AspNetCoreVersion>
    <SwashbuckleVersion>9.*</SwashbuckleVersion>
  </PropertyGroup>

  <PropertyGroup Label="Versioning" Condition="'$(TargetFramework)' == 'net8.0'">
    <MicrosoftExtensionsVersion>8.0.*</MicrosoftExtensionsVersion>
    <EFVersion>8.0.*</EFVersion>
    <NpgsqlVersion>8.0.*</NpgsqlVersion>
    <MvcTesting>$(MicrosoftExtensionsVersion)</MvcTesting>
    <AspNetCoreVersion>$(MicrosoftExtensionsVersion)</AspNetCoreVersion>
    <SwashbuckleVersion>8.*</SwashbuckleVersion>
  </PropertyGroup>

  <PropertyGroup Label="Versioning" Condition="'$(TargetFramework)' == 'net6.0'">
    <MicrosoftExtensionsVersion>8.0.*</MicrosoftExtensionsVersion>
    <EFVersion>7.0.*</EFVersion>
    <NpgsqlVersion>7.0.*</NpgsqlVersion>
    <FinbuckleVersion>8.1.*</FinbuckleVersion>
    <MvcTesting>6.0.*</MvcTesting>
    <OpenApiVersion>1.6.*</OpenApiVersion>
    <SwashbuckleVersion>6.9.*</SwashbuckleVersion>
    <AspNetCoreVersion>6.*</AspNetCoreVersion>
  </PropertyGroup>


  <PropertyGroup Label="Build">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EnableSourceLink>false</EnableSourceLink>
    <BaseIntermediateOutputPath>$(SolutionDir)/build/obj/$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <OutputPath>$(SolutionDir)/build/bin/$(Configuration)/$(MSBuildProjectName)</OutputPath>
    <PackageLocation>$(SolutionDir)build/publish/$(Configuration)/</PackageLocation>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
