{
  "Juice": {
    "EventBus": {
      "Connections": {
        "Nats": {
          "Url": "nats://localhost:4222",
          "ConnectTimeout": "00:00:02",
          "ReconnectWaitMin": "00:00:01",
          "ReconnectWaitMax": "00:00:05",
          "MaxReconnectRetry": -1
        }
      },
      "PublishingPolicies": {
        "Default": {
          "Publishers": [
            {
              "Key": "nats",
              "Destination": "xunit.content"
            }
          ]
        }
      },
      "ConsumeRetryPolicies": {
        "Default": {
          "RetryTiers": [ "1s", "2s" ],
          "IsParkingEnabled": true
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Juice": "Trace"
    }
  }
}
