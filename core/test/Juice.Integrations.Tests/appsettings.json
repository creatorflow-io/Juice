{
  "Juice": {
    "EventBus": {
      "Connections": {
        "RabbitMQ": {
          "Connection": null,
          "Port": 5672,
          "VirtualHost": null,
          "UserName": null,
          "Password": null,
          "ConnectionMaxRetries": 5
        }
      },
      "PublishingPolicies": {
        "Default": {
          "Publishers": [
            {
              "Key": "rabbitmq",
              "Destination": "default_exchange"
            }
          ]
        },
        "Rules": [
          {
            "Priority": 1000,
            "Match": {
              "TenantIdentifier": "tenant-a",
              "Event": "ContentPublishedIntegrationEvent"
            },
            "Publishers": [
              {
                "Key": "rabbitmq1",
                "Destination": "x.content.vip"
              }
            ]
          },
          {
            "Priority": 800,
            "Match": {
              "TenantTier": "enterprise",
              "Event": "ContentPublishedIntegrationEvent"
            },
            "Publishers": [
              {
                "Key": "rabbitmq1",
                "Destination": "x.content.integration"
              },
              {
                "Key": "kafka",
                "Destination": "x.content.stream"
              }
            ]
          },

          {
            "Priority": 600,
            "Match": {
              "Domain": "TestContext"
            },
            "Publishers": [
              {
                "Key": "rabbitmq",
                "Destination": "x.content.integration"
              },
              {
                "Key": "rabbitmq1",
                "Destination": "x.content.integration"
              }
            ]
          },

          {
            "Priority": 600,
            "Match": {
              "Event": "LogEvent"
            },
            "Publishers": [
              {
                "Key": "rabbitmq",
                "Destination": "x.logs"
              }
            ]
          },

          {
            "Priority": 0,
            "Match": {},
            "Publishers": [
              {
                "Key": "rabbitmq",
                "Destination": "default_exchange"
              }
            ]
          }
        ]
      },
      "DeliveryPolicies": {
        "DefaultPolicy": {
          "Interval": "00:00:05",
          "BatchSize": 10,
          "Timeout": "00:05:00",
          "InitialRetryDelay": "00:00:05",
          "RetryDelayMultiplier": 2.0,
          "MaxRetryAttempts": 3
        },
        "Policies": {
          "rabbitmq__send-pending__*": {
            "Interval": "00:00:01",
            "BatchSize": 20
          },
          "rabbitmq__retry-failed__*": {
            "InitialRetryDelay": "00:00:10",
            "MaxRetryAttempts": 5
          },
          "*__recover-timeout__*": {
            "Timeout": "00:10:00"
          }
        }
      },
      "RabbitMQ:RetryPolicies": {
        "Policies": [
          {
            "SourceExchange": "x.logs",
            "RetryExchange": "x.logs.retry",
            "RetryTiers": [ "retry.1s", "retry.1s1", "retry.1s2" ]
          }
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Juice": "Trace"
    }
  }
}
