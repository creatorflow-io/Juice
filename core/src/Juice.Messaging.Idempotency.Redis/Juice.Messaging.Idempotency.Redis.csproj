<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFramework)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Mediator's request manager with Redis repository</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Extensions.Redis\Juice.Extensions.Redis.csproj" />
    <ProjectReference Include="..\Juice.Messaging\Juice.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="$(RedisVersion)" />
  </ItemGroup>
</Project>
